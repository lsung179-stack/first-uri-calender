<?xml version="1.0" encoding="utf-8"?>
<!-- 우리 캘린더 오늘 위젯(small) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/tw_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8B3A2A" android:textSize="15sp" android:textStyle="bold" android:text="오늘" />
        <TextView android:id="@+id/tw_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:paddingLeft="5dp" android:paddingRight="5dp" android:background="@drawable/chip_on" android:textColor="#F6EFE0" android:textSize="10sp" android:textStyle="bold" android:text="0" android:visibility="gone" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/tw_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="6dp" android:paddingRight="6dp" android:textColor="#8A6C52" android:textSize="14sp" android:text="↻" />
        <TextView android:id="@+id/tw_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8B3A2A" android:textSize="18sp" android:textStyle="bold" android:text="＋" />
    </LinearLayout>

    <TextView android:id="@+id/tw_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#8A6C52" android:textSize="11sp" android:visibility="gone" android:text="오늘 일정이 없어요" />

    <LinearLayout android:id="@+id/tw_evrow0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:visibility="gone">
        <View android:id="@+id/tw_evbar0" android:layout_width="3dp" android:layout_height="15dp" android:background="#8B3A2A" android:layout_marginEnd="7dp" />
        <TextView android:id="@+id/tw_evtitle0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#2A1C0F" android:textSize="12sp" android:textStyle="bold" android:text="" />
        <TextView android:id="@+id/tw_evtime0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#8A6C52" android:textSize="10sp" android:text="" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tw_evrow1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:visibility="gone">
        <View android:id="@+id/tw_evbar1" android:layout_width="3dp" android:layout_height="15dp" android:background="#8B3A2A" android:layout_marginEnd="7dp" />
        <TextView android:id="@+id/tw_evtitle1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#2A1C0F" android:textSize="12sp" android:textStyle="bold" android:text="" />
        <TextView android:id="@+id/tw_evtime1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#8A6C52" android:textSize="10sp" android:text="" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tw_evrow2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:visibility="gone">
        <View android:id="@+id/tw_evbar2" android:layout_width="3dp" android:layout_height="15dp" android:background="#8B3A2A" android:layout_marginEnd="7dp" />
        <TextView android:id="@+id/tw_evtitle2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#2A1C0F" android:textSize="12sp" android:textStyle="bold" android:text="" />
        <TextView android:id="@+id/tw_evtime2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#8A6C52" android:textSize="10sp" android:text="" />
    </LinearLayout>

    <LinearLayout android:id="@+id/tw_tdrow0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:visibility="gone">
        <TextView android:id="@+id/tw_tdtitle0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#2A1C0F" android:textSize="12sp" android:text="" />
        <TextView android:id="@+id/tw_tdtime0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#8A6C52" android:textSize="10sp" android:text="" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tw_tdrow1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:visibility="gone">
        <TextView android:id="@+id/tw_tdtitle1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#2A1C0F" android:textSize="12sp" android:text="" />
        <TextView android:id="@+id/tw_tdtime1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#8A6C52" android:textSize="10sp" android:text="" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
