<?xml version="1.0" encoding="utf-8"?>
<!-- 월 위젯 한 칸: 날짜 숫자 + 이벤트 칩 2개 + 넘침 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:paddingLeft="0dp"
    android:paddingRight="0dp"
    android:paddingTop="2dp">

    <TextView
        android:id="@+id/cell_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#2A1C0F"
        android:textSize="11sp"
        android:text="1" />

    <TextView
        android:id="@+id/cell_ev1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_ev2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_todo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="#2A1C0F"
        android:textSize="7sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8A6C52"
        android:textSize="7sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="+1" />
</LinearLayout>
