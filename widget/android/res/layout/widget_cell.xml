<?xml version="1.0" encoding="utf-8"?>
<!-- 월 위젯 한 칸: 날짜 숫자 + 이벤트 칩 2개 + 넘침 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:paddingLeft="0dp"
    android:paddingRight="0dp"
    android:paddingTop="2dp">

    <!-- 날짜 숫자칸은 오늘/평일 구분 없이 항상 정사각 고정 (iOS numBox 파리티).
         · 정사각이라 오늘 표시 oval이 타원이 되지 않고 정원으로 그려짐
         · 높이가 항상 같아서 오늘 칸의 일정 줄이 아래로 밀리지 않음(같은 주 날짜끼리 정렬 유지) -->
    <TextView
        android:id="@+id/cell_day"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#2A1C0F"
        android:textSize="11sp"
        android:text="1" />

    <TextView
        android:id="@+id/cell_ev1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_ev2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_ev3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_ev4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_ev5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_todo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="#2A1C0F"
        android:textSize="7sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8A6C52"
        android:textSize="7sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="+1" />
</LinearLayout>
