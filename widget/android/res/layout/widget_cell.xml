<?xml version="1.0" encoding="utf-8"?>
<!-- 월 위젯 한 칸: 날짜 숫자 + 이벤트 칩 + 넘침 + 날짜 강조(테두리/채움/라벨)

     WARNING: RemoteViews는 허용 목록의 뷰만 인플레이트할 수 있고 순수 View는 목록에 없다
     (예전에 View 스페이서 때문에 위젯이 통째로 빈 화면이 된 적 있음).
     그래서 강조 테두리 띠도 View가 아니라 FrameLayout으로 만든다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp">

    <!-- 강조 채움(파스텔/진한 채움) — 날짜·일정 뒤에 깔림 -->
    <FrameLayout
        android:id="@+id/cell_hl_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cell_col"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top|center_horizontal"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:paddingTop="2dp">

    <!-- 날짜 숫자칸은 오늘/평일 구분 없이 항상 정사각 고정 (iOS numBox 파리티).
         · 정사각이라 오늘 표시 oval이 타원이 되지 않고 정원으로 그려짐
         · 높이가 항상 같아서 오늘 칸의 일정 줄이 아래로 밀리지 않음(같은 주 날짜끼리 정렬 유지) -->
    <TextView
        android:id="@+id/cell_day"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#2A1C0F"
        android:textSize="11sp"
        android:text="1" />

    <!-- 강조 라벨: 앱은 칸 위로 솟은 탭이지만 위젯 칸엔 그럴 여백이 없어 색 바로 표시(라벨 쓰는 테마만) -->
    <TextView
        android:id="@+id/cell_hl_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <!-- 빨간날(공휴일) 바: 앱은 텍스트만 표시하지만 위젯은 빨간 바로 자동 표시 -->
    <TextView
        android:id="@+id/cell_holiday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#C0503F"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_ev1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_ev2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_ev3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_ev4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_ev5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:minHeight="13dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:background="#8B3A2A"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_todo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="#2A1C0F"
        android:textSize="7sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/cell_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8A6C52"
        android:textSize="7sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="+1" />
</LinearLayout>

    <!-- 강조 테두리 4변 — 이웃 날짜가 범위 밖인 변만 보이게(격자선에 딱 맞는 사각 경계, 모서리 직각) -->
    <FrameLayout android:id="@+id/cell_hl_t" android:layout_width="match_parent" android:layout_height="2dp" android:layout_gravity="top" android:visibility="gone" />
    <FrameLayout android:id="@+id/cell_hl_b" android:layout_width="match_parent" android:layout_height="2dp" android:layout_gravity="bottom" android:visibility="gone" />
    <FrameLayout android:id="@+id/cell_hl_l" android:layout_width="2dp" android:layout_height="match_parent" android:layout_gravity="left" android:visibility="gone" />
    <FrameLayout android:id="@+id/cell_hl_r" android:layout_width="2dp" android:layout_height="match_parent" android:layout_gravity="right" android:visibility="gone" />
</FrameLayout>
