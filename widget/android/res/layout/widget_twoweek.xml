<?xml version="1.0" encoding="utf-8"?>
<!-- 우리 캘린더 2주 위젯(medium) 루트 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/wg_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView android:id="@+id/wg_seal" android:layout_width="24dp" android:layout_height="24dp" android:scaleType="fitCenter" android:layout_marginEnd="5dp" />
        <TextView android:id="@+id/wg_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="5dp" android:paddingRight="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="9sp" android:textStyle="bold" android:textColor="#8A6C52" android:text="전체" android:layout_marginEnd="3dp" />
        <ImageView android:id="@+id/wg_av0" android:layout_width="21dp" android:layout_height="21dp" android:padding="2dp" android:scaleType="fitCenter" android:layout_marginEnd="2dp" android:visibility="gone" />
        <ImageView android:id="@+id/wg_av1" android:layout_width="21dp" android:layout_height="21dp" android:padding="2dp" android:scaleType="fitCenter" android:layout_marginEnd="2dp" android:visibility="gone" />
        <ImageView android:id="@+id/wg_av2" android:layout_width="21dp" android:layout_height="21dp" android:padding="2dp" android:scaleType="fitCenter" android:layout_marginEnd="2dp" android:visibility="gone" />
        <ImageView android:id="@+id/wg_av3" android:layout_width="21dp" android:layout_height="21dp" android:padding="2dp" android:scaleType="fitCenter" android:layout_marginEnd="2dp" android:visibility="gone" />
        <TextView android:id="@+id/wg_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textStyle="bold" android:textColor="#8A6C52" android:text="+0" android:visibility="gone" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView android:id="@+id/wg_wprev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="6dp" android:paddingRight="3dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textColor="#8B3A2A" android:textSize="15sp" android:textStyle="bold" android:text="‹" />
        <TextView android:id="@+id/wg_wlabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingBottom="2dp" android:textColor="#2A1C0F" android:textSize="12sp" android:textStyle="bold" android:text="7.6~19" />
        <TextView android:id="@+id/wg_wnext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="3dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textColor="#8B3A2A" android:textSize="15sp" android:textStyle="bold" android:text="›" />
        <TextView android:id="@+id/wg_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="4dp" android:paddingRight="4dp" android:textColor="#8A6C52" android:textSize="14sp" android:text="↻" />
        <TextView android:id="@+id/wg_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="3dp" android:textColor="#8B3A2A" android:textSize="15sp" android:textStyle="bold" android:text="⤴" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#C0503F" android:textSize="10sp" android:textStyle="bold" android:text="일" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#8A6C52" android:textSize="10sp" android:textStyle="bold" android:text="월" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#8A6C52" android:textSize="10sp" android:textStyle="bold" android:text="화" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#8A6C52" android:textSize="10sp" android:textStyle="bold" android:text="수" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#8A6C52" android:textSize="10sp" android:textStyle="bold" android:text="목" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#8A6C52" android:textSize="10sp" android:textStyle="bold" android:text="금" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#8A6C52" android:textSize="10sp" android:textStyle="bold" android:text="토" />
    </LinearLayout>

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:numColumns="7"
        android:stretchMode="columnWidth"
        android:verticalSpacing="0dp"
        android:horizontalSpacing="0dp"
        android:gravity="fill" />

    <TextView
        android:id="@+id/wg_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#8A6C52"
        android:textSize="12sp"
        android:visibility="gone"
        android:text="앱을 열어 방에 입장해 주세요" />
</LinearLayout>
