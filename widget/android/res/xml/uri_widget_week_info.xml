<?xml version="1.0" encoding="utf-8"?>
<!-- '이번 주' 위젯(large 4×4). previewLayout = 안드로이드 12+ 위젯 목록에서 실제 레이아웃으로 미리보기. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:minResizeWidth="180dp"
    android:minResizeHeight="220dp"
    android:updatePeriodMillis="1800000"
    android:previewImage="@drawable/widget_preview_week"
    android:previewLayout="@layout/widget_week"
    android:initialLayout="@layout/widget_week"
    android:resizeMode="horizontal|vertical"
    android:maxResizeWidth="640dp"
    android:maxResizeHeight="760dp"
    android:widgetCategory="home_screen"
    android:description="@string/app_name" />
